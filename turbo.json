{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": [".vitest/**", "node_modules/.cache/**"]
    },
    "lint": {
      "cache": false,
      "dependsOn": ["^lint"]
    },
    "lint-fix": {
      "cache": false,
      "dependsOn": ["^lint-fix"]
    },
    "format": {
      "cache": false,
      "dependsOn": ["^format"]
    }
  }
}
